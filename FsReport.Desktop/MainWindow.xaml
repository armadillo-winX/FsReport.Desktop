<Window x:Class="FsReport.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FsReport.Desktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="452" Width="435" Closing="MainWindowClosing">
    <Grid>
        <Menu Height="18" VerticalAlignment="Top">
            <MenuItem x:Name="FileMenu" Header="ファイル(_F)">
                <MenuItem x:Name="ExitMenuItem" Header="終了(_X)" Click="ExitMenuItemClick"/>
            </MenuItem>
            <MenuItem x:Name="OptionMenu" Header="オプション(_O)">
                <MenuItem x:Name="AlwaysOnTopMenuItem" Header="最前面に表示(_M)"
                        IsCheckable="True" Click="AlwaysOnTopMenuItemClick"/>
            </MenuItem>
            <MenuItem x:Name="HelpMenu" Header="ヘルプ(_H)">
                <MenuItem x:Name="AboutMenuItem" Header="バージョン情報(_A)" Click="AboutMenuItemClick"/>
            </MenuItem>
        </Menu>
        <Label Content="レポートルートディレクトリ:" HorizontalAlignment="Left" Margin="10,23,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="ReportRootDirBox"
            Margin="10,54,57,0" TextWrapping="NoWrap"
            MaxLines="1" Text="" VerticalAlignment="Top"/>
        <Button x:Name="BrowseRootDirButton"
            Content="参照(_B)" Margin="0,53,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="42" Click="BrowseRootDirButtonClick"/>
        <Label Content="科目:" HorizontalAlignment="Left" Margin="10,77,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="SubjectComboBox"
            Margin="96,79,10,0" VerticalAlignment="Top"/>
        <Label Content="テンプレートファイル一覧:" HorizontalAlignment="Left" Margin="10,170,0,0" VerticalAlignment="Top"/>
        <ListBox x:Name="TemplateFilesListBox" Margin="10,201,10,120" ScrollViewer.CanContentScroll="True"/>
        <Label Content="レポートのファイル名(拡張子なし):" HorizontalAlignment="Left" Margin="10,0,0,89" VerticalAlignment="Bottom"/>
        <TextBox x:Name="ReportFileNameBox" Margin="10,0,33,66" TextWrapping="NoWrap" MaxLines="1" Text="" Height="18" VerticalAlignment="Bottom"/>
        <Button x:Name="CreateButton"
                Width="120" Height="24"
            Content="作成(_C)" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Click="CreateButtonClick"/>
        <CheckBox x:Name="AutomaticallyOpenReportFileCheckBox"
            Content="自動でレポートファイルを開く" HorizontalAlignment="Left" Margin="10,0,0,10" Height="15" VerticalAlignment="Bottom"/>
        <Button x:Name="InputParameterButton"
            Content="..." Width="18" HorizontalAlignment="Right" Margin="0,0,10,65" VerticalAlignment="Bottom" 
            Click="InputParameterButtonClick"
            ContextMenuService.Placement="Bottom">
            <Button.ContextMenu>
                <ContextMenu x:Name="InputParameterButtonContextMenu" Placement="Bottom">
                    <MenuItem Header="%SubjectName%" Uid="SubjectName" Click="InputParameterMenuClick"/>
                    <MenuItem Header="%SubjectFolder%" Uid="SubjectFolder" Click="InputParameterMenuClick"/>
                    <MenuItem Header="%ReportFolder%" Uid="ReportFolder" Click="InputParameterMenuClick"/>
                    <MenuItem Header="%ReportType%" Uid="ReportType" Click="InputParameterMenuClick"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <Label Content="レポートの種類:" HorizontalAlignment="Left" Margin="10,108,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="ReportTypeComboBox"
            Margin="96,110,10,0" VerticalAlignment="Top" SelectionChanged="ReportTypeComboBoxSelectionChanged">
            <ComboBoxItem Uid="Numbering" Content="回数レポート"/>
            <ComboBoxItem Uid="Midterm" Content="中間レポート"/>
            <ComboBoxItem Uid="Final" Content="期末レポート"/>
            <ComboBoxItem Uid="Other" Content="その他"/>
        </ComboBox>
        <Label x:Name="OptionalReportFolderNameLabel"
            Content="レポートフォルダ名(手入力):" HorizontalAlignment="Left" Margin="10,139,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="OptionalReportFolderNameBox" 
            Margin="153,143,10,0" TextWrapping="NoWrap" MaxLines="1" Text="" VerticalAlignment="Top"/>
        <Button 
            x:Name="AddTemplateFileButton"
            Content="+" Height="24" 
            ToolTip="テンプレートファイルの追加" Margin="137,171,0,0" VerticalAlignment="Top" Click="AddTemplateFileButtonClick" HorizontalAlignment="Left" Width="24"/>

    </Grid>
</Window>
