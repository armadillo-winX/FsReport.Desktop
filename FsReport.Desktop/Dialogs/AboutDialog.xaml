<Window x:Class="FsReport.Desktop.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FsReport.Desktop.Dialogs"
        mc:Ignorable="d"
        Title="バージョン情報" Height="223" Width="291" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <TextBlock 
            x:Name="NameBlock"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,10,0,0" TextWrapping="Wrap" Text="AppName" VerticalAlignment="Top" FontWeight="Bold" FontSize="18" />
        <TextBlock 
            x:Name="VersionBlock"
            HorizontalAlignment="Center" Margin="0,47,0,0" TextWrapping="Wrap" Text="AppVersion" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock
            x:Name="CopyrightBlock"
            HorizontalAlignment="Center" Margin="0,85,0,0" TextWrapping="Wrap" Text="Copyright" VerticalAlignment="Top" FontSize="14"/>
        <Button
            x:Name="OKButton"
            Width="90" Height="24"
            Content="OK" IsDefault="True" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Click="OKButtonClick"/>

    </Grid>
</Window>
