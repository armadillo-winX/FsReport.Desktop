<Window x:Class="FsReport.Desktop.Dialogs.AddSubjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FsReport.Desktop.Dialogs"
        mc:Ignorable="d"
        Title="科目の追加" Height="223" Width="278" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Label Content="科目名:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="SubjectNameBox" Margin="10,41,10,0" TextWrapping="NoWrap" MaxLines="1" Text="" 
            VerticalAlignment="Top"/>
        <Label Content="科目に割り当てるフォルダ名:" HorizontalAlignment="Left" Margin="10,64,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="SubjectFolderNameBox"
            Margin="10,95,10,0" TextWrapping="NoWrap" MaxLines="1" Text="" VerticalAlignment="Top"/>
        <Button x:Name="AddButton"
            IsDefault="True" Width="90" Height="24"
            Content="追加(_A)" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Click="AddButtonClick"/>

    </Grid>
</Window>
